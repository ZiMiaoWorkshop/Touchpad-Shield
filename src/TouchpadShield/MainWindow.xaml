<Window
    x:Class="TouchpadShield.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Touchpad Shield">

    <Grid MinWidth="1280" MinHeight="900" Padding="24,24,24,12" RowSpacing="16" ColumnSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Touchpad Shield" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton"
                        Content="刷新数据"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center" />
            </StackPanel>
            <HyperlinkButton Grid.Column="1"
                             Content="更多触控板功能设定"
                             Click="MoreTouchpadSettings_Click"
                             VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="12">
                    <TextBlock Text="灵敏度设定 (Sensitivity)" FontSize="20" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="单击灵敏度 (Click Sensitivity)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <Grid Margin="12,0,8,0">
                                    <Slider x:Name="ClickSensitivitySlider"
                                            Minimum="0"
                                            Maximum="100"
                                            StepFrequency="1"
                                            TickFrequency="50"
                                            TickPlacement="Outside"
                                            HorizontalAlignment="Stretch"
                                            ValueChanged="ClickSensitivitySlider_ValueChanged" />
                                </Grid>
                                <Grid Margin="12,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="轻 0" HorizontalAlignment="Left" Opacity="0.8" />
                                    <TextBlock Text="中 50" Grid.Column="1" HorizontalAlignment="Center" Opacity="0.8" />
                                    <TextBlock Text="重 100" Grid.Column="2" HorizontalAlignment="Right" Opacity="0.8" />
                                </Grid>
                            </StackPanel>
                            <TextBlock x:Name="ClickSensitivityValueText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       MinWidth="64"
                                       Opacity="0.9" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="单击灵敏度控制方式 (Click Sensitivity Control Mode)" />
                        <ComboBox x:Name="ClickModeComboBox"
                                  SelectionChanged="ClickModeComboBox_SelectionChanged"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="触板灵敏度 (Touchpad Sensitivity)" />
                        <ComboBox x:Name="TouchpadSensitivityComboBox"
                                  SelectionChanged="TouchpadSensitivityComboBox_SelectionChanged"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="轻拍触控板进行单击 (Tap with a single finger to single-click)"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="TapsEnabledSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource RightAlignedToggleSwitchStyle}"
                                      Toggled="TapsEnabledSwitch_Toggled" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="12">
                    <TextBlock Text="屏蔽区域设定 (Curtains / Super Curtains)" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="缓冲区域 (Smart Area)" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SmartAreaSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource RightAlignedToggleSwitchStyle}"
                                      Toggled="SmartAreaSwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="上 (CurtainTop)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="CurtainTopBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="CurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="下 (CurtainBottom)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="CurtainBottomBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="CurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="左 (CurtainLeft)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="CurtainLeftBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="CurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="右 (CurtainRight)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="CurtainRightBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="CurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="防误触区域 (Smart Edge)" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SmartEdgeSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource RightAlignedToggleSwitchStyle}"
                                      Toggled="SmartEdgeSwitch_Toggled" />
                    </Grid>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="上 (SuperCurtainTop)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="SuperCurtainTopBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="SuperCurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="下 (SuperCurtainBottom)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="SuperCurtainBottomBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="SuperCurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="左 (SuperCurtainLeft)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="SuperCurtainLeftBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="SuperCurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="右 (SuperCurtainRight)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="SuperCurtainRightBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="0" ValueChanged="SuperCurtainValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="笔记本电脑型号 (Laptop Model)" FontSize="20" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LaptopModelText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="ExportTouchpadSizeButton"
                                Grid.Column="1"
                                Content="导出当前触控板物理尺寸设定"
                                Click="ExportTouchpadSizeButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                MinWidth="220"
                                Padding="16,8" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="MatchedSizeText" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="ApplyMatchedSizeButton"
                                Content="应用预设的触控板物理尺寸"
                                Visibility="Collapsed"
                                Click="ApplyMatchedSizeButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                VerticalAlignment="Center"
                                MinWidth="260"
                                Padding="16,8"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="触控板物理尺寸 (Touchpad Physical Size)" FontSize="20" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="横向宽度 (Width)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="TouchpadWidthBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="1" ValueChanged="TouchpadSizeValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="纵向高度 (Height)" />
                            <Grid MinHeight="32">
                                <NumberBox x:Name="TouchpadHeightBox" Style="{StaticResource MmNumberBoxFieldStyle}" Minimum="1" ValueChanged="TouchpadSizeValueChanged" />
                                <TextBlock Style="{StaticResource MmNumberBoxUnitStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock Text="触控板示意图 (Touchpad Diagram)" FontSize="20" FontWeight="SemiBold" />
                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <Canvas x:Name="DiagramCanvas" Height="380" SizeChanged="DiagramCanvas_SizeChanged" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle Width="16" Height="16" Fill="#80FFD700" Stroke="#FFD700" />
                            <TextBlock Text="缓冲区域 (Smart Area)" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle Width="16" Height="16" Fill="#80DC143C" Stroke="#DC143C" />
                            <TextBlock Text="防误触区域 (Smart Edge)" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="DiagramWarningText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12" MinHeight="38" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="RestartPanel"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock Text="屏蔽区域设定已更改，需要重启电脑后生效。"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap" />
                <Button x:Name="RestartButton"
                        Content="重启"
                        Click="RestartButton_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        MinWidth="88"
                        Padding="16,6" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Designed and Built by ZiMiaoWorkshop" VerticalAlignment="Center" Opacity="0.85" />
                <TextBlock x:Name="VersionTextBlock" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
