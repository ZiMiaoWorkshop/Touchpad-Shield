<Application
    x:Class="TouchpadShield.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="ToggleSwitchRowHeight">32</x:Double>

            <Style x:Key="MmNumberBoxFieldStyle" TargetType="NumberBox">
                <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
                <Setter Property="Padding" Value="12,8,58,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="MmNumberBoxUnitStyle" TargetType="TextBlock">
                <Setter Property="Text" Value="mm" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,-2,40,0" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <Style x:Key="RightAlignedToggleSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="{StaticResource ToggleSwitchRowHeight}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
